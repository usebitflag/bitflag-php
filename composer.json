{
  "name": "bitflag/bitflag-php",
  "description": "BitFlag evaluation core and PHP SDK",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": ">=8.3"
  },
  "autoload": {
    "psr-4": {
      "BitFlag\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BitFlag\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "test": "pest",
    "lint": "pint --test",
    "analyse": "phpstan analyse --memory-limit=1G",
    "conformance": "php scripts/conformance-report.php",
    "fetch-protocol": "scripts/fetch-protocol-fixtures.sh"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require-dev": {
    "laravel/pint": "^1.32",
    "pestphp/pest": "^4.7",
    "phpstan/phpstan": "^2.3"
  },
  "extra": {
    "bitflag": {
      "protocol": "0.1.0-alpha.1"
    }
  }
}
